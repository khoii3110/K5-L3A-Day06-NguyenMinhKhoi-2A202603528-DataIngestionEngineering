# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Use OpenRouter or OpenAI. If only one key is set, the provider is auto-detected.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional for custom models; text-embedding-3-small defaults to 1536 dimensions.
EMBEDDING_DIMENSIONS=
# Optional: set the provider's current USD price per million input tokens for cost estimates.
EMBEDDING_USD_PER_1M_TOKENS=
